    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Premium full-bleed navy → indigo → violet base -->
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="100"
                android:endX="90"
                android:endY="8"
                android:type="linear">
                <item android:offset="0" android:color="#141831"/>
                <item android:offset="0.52" android:color="#25264F"/>
                <item android:offset="1" android:color="#393568"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Very soft cool highlight for depth; no hard shapes -->
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="72"
                android:centerY="26"
                android:gradientRadius="76"
                android:type="radial">
                <item android:offset="0" android:color="#146E6AA4"/>
                <item android:offset="0.48" android:color="#08605B96"/>
                <item android:offset="1" android:color="#00393568"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
